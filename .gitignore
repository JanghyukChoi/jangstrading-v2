# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# preview output
scripts/_preview.json

# backtest data (local only)
scripts/backtest_data/

# ML artifacts (local only, not used in live)
scripts/ml_artifacts/

# python
scripts/__pycache__/
*.pyc

# KIS 접근토큰 캐시 (scripts/kis_api.py)
.kis_token.json

# .env.example 은 필요한 시크릿 목록이라 커밋한다
!.env.example
