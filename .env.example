# KRX Data Marketplace 로그인 (pykrx v1.2+ 필수)
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# KRX OpenAPI 인증키 (업종 분류 조회용)
KRX_API_KEY=your_krx_api_key

# 한국투자증권(KIS) Open API — https://apiportal.koreainvestment.com
# KRX 스크래핑 차단(2026-07) 이후 수급/시세 데이터의 공식 소스
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ENV=real

# Gemini (AI 시황 리포트) — https://aistudio.google.com/apikey
# 무료 티어. Anthropic 크레딧 소진으로 2026-09-14 이전.
GEMINI_API_KEY=your_gemini_api_key
